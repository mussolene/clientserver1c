#!/usr/bin/with-contenv sh
set -eu

runtime_mode="${ONEC_RUNTIME_MODE:-shell}"
file_db_path="${ONEC_FILE_DB_PATH:-/mnt/data/testdb}"
file_db_name="${ONEC_FILE_DB_NAME:-1C Development}"
platform_version="${PLATFORM_VERSION:-8.5.1.1302}"
srv_debug="${SRV1CV8_DEBUG:-1}"
srv_port="${SRV1CV8_PORT:-1540}"
srv_regport="${SRV1CV8_REGPORT:-1541}"
srv_range="${SRV1CV8_RANGE:-1560:1691}"
disable_unsafe_actions_pattern="${ONEC_DISABLE_UNSAFE_ACTION_PROTECTION:-.*}"

export HOME=/root

ensure_conf_line() {
  conf_file="$1"
  desired_line="$2"
  desired_key="${desired_line%%=*}"
  conf_dir="$(dirname "$conf_file")"

  mkdir -p "$conf_dir"
  if [ -f "$conf_file" ] && grep -q "^${desired_key}=" "$conf_file"; then
    tmp_file="${conf_file}.tmp.$$"
    awk -v desired="$desired_line" -v key="$desired_key" '
      BEGIN { replaced = 0 }
      $0 ~ "^" key "=" {
        if (!replaced) {
          print desired
          replaced = 1
        }
        next
      }
      { print }
      END {
        if (!replaced) {
          print desired
        }
      }
    ' "$conf_file" >"$tmp_file"
    mv "$tmp_file" "$conf_file"
  else
    {
      if [ -f "$conf_file" ]; then
        cat "$conf_file"
        printf '\n'
      fi
      printf '%s\n' "$desired_line"
    } >"$conf_file"
  fi
}

ensure_1cestart_line() {
  cfg_file="$1"
  desired_line="$2"
  owner="$3"
  desired_key="${desired_line%%=*}"
  cfg_dir="$(dirname "$cfg_file")"
  text_file="${cfg_file}.utf8.$$"
  next_file="${cfg_file}.next.$$"

  mkdir -p "$cfg_dir"
  if [ -f "$cfg_file" ]; then
    iconv -f UTF-16LE -t UTF-8 "$cfg_file" >"$text_file" 2>/dev/null || cp "$cfg_file" "$text_file"
  else
    : >"$text_file"
  fi

  awk -v desired="$desired_line" -v key="$desired_key" '
    BEGIN { replaced = 0 }
    $0 ~ "^" key "=" {
      if (!replaced) {
        print desired
        replaced = 1
      }
      next
    }
    { print }
    END {
      if (!replaced) {
        print desired
      }
    }
  ' "$text_file" >"${text_file}.next"

  iconv -f UTF-8 -t UTF-16LE "${text_file}.next" >"$next_file"
  mv "$next_file" "$cfg_file"
  rm -f "$text_file" "${text_file}.next"
  chown -R "$owner" "$cfg_dir" 2>/dev/null || true
}

configure_unsafe_action_protection() {
  [ -n "$disable_unsafe_actions_pattern" ] || return 0

  managed_line="DisableUnsafeActionProtection=${disable_unsafe_actions_pattern}"

  ensure_conf_line /opt/1cv8/conf/conf.cfg "$managed_line"
  ensure_conf_line /opt/1cv8/current/conf/conf.cfg "$managed_line"
  ensure_conf_line /root/.1cv8/1C/1cv8/conf/conf.cfg "$managed_line"
  if getent passwd usr1cv8 >/dev/null 2>&1; then
    ensure_conf_line /home/usr1cv8/.1cv8/1C/1cv8/conf/conf.cfg "$managed_line"
    chown -R usr1cv8:grp1cv8 /home/usr1cv8/.1cv8 2>/dev/null || true
  fi
}

configure_hardware_license_defaults() {
  ensure_1cestart_line /root/.1C/1cestart/1cestart.cfg "UseHwLicenses=1" root:root
  if getent passwd usr1cv8 >/dev/null 2>&1; then
    ensure_1cestart_line /home/usr1cv8/.1C/1cestart/1cestart.cfg "UseHwLicenses=1" usr1cv8:grp1cv8
  fi
}

configure_nethasp_locations() {
  source_file=""
  for candidate in \
    /opt/1cv8/conf/nethasp.ini \
    /opt/1cv8/current/conf/nethasp.ini \
    /etc/1C/1cv8/conf/nethasp.ini \
    /root/.1cv8/1C/1cv8/conf/nethasp.ini \
    /home/usr1cv8/.1cv8/1C/1cv8/conf/nethasp.ini
  do
    if [ -r "$candidate" ]; then
      source_file="$candidate"
      break
    fi
  done

  [ -n "$source_file" ] || return 0

  for target_file in \
    /opt/1cv8/conf/nethasp.ini \
    /opt/1cv8/current/conf/nethasp.ini \
    /etc/1C/1cv8/conf/nethasp.ini \
    /root/.1cv8/1C/1cv8/conf/nethasp.ini \
    /home/usr1cv8/.1cv8/1C/1cv8/conf/nethasp.ini
  do
    mkdir -p "$(dirname "$target_file")"
    if [ -f "$target_file" ] && cmp -s "$source_file" "$target_file"; then
      continue
    fi
    if ! cp "$source_file" "$target_file" 2>/dev/null; then
      echo "Warning: could not propagate nethasp.ini to a runtime profile path" >&2
      continue
    fi
    if ! chmod 0644 "$target_file" 2>/dev/null; then
      echo "Warning: could not set nethasp.ini permissions on a runtime profile path" >&2
    fi
  done

  if getent passwd usr1cv8 >/dev/null 2>&1; then
    chown -R usr1cv8:grp1cv8 /home/usr1cv8/.1cv8 2>/dev/null || true
  fi
}

write_ibases() {
  target_home="$1"
  target_user="$2"
  target_group="$3"

  /opt/onec-agent/bin/onec-agent-ibase add \
    --name "$file_db_name" \
    --path "$file_db_path" \
    --home "$target_home" \
    --owner "$target_user:$target_group" \
    --version "${platform_version%.*}"
}

write_desktop_shortcut() {
  target_home="$1"
  target_user="$2"
  target_group="$3"
  desktop_dir="$target_home/Desktop"
  desktop_file="$desktop_dir/1cestart.desktop"
  icon_version="${platform_version%.*}-${platform_version##*.}"
  icon_name="1cestart-${icon_version}"
  launcher_binary="/opt/1cv8/common/1cestart"

  [ -x "$launcher_binary" ] || {
    echo "1C desktop launcher is missing: $launcher_binary" >&2
    exit 1
  }
  [ -f "/usr/share/pixmaps/${icon_name}.png" ] || {
    echo "1C desktop launcher icon is missing: /usr/share/pixmaps/${icon_name}.png" >&2
    exit 1
  }

  mkdir -p "$desktop_dir"
  cat >"$desktop_file" <<EOF_DESKTOP
[Desktop Entry]
Version=1.0
Type=Application
Name=1C:Enterprise Launcher
Comment=Launch 1C:Enterprise
Exec=${launcher_binary}
Icon=${icon_name}
Terminal=false
Categories=Office;Development;
StartupNotify=true
EOF_DESKTOP
  chmod 0755 "$desktop_file"
  chown -R "$target_user:$target_group" "$desktop_dir" 2>/dev/null || true
}

configure_desktop_integration() {
  if getent passwd usr1cv8 >/dev/null 2>&1; then
    write_ibases /home/usr1cv8 usr1cv8 grp1cv8
    write_desktop_shortcut /home/usr1cv8 usr1cv8 grp1cv8
  fi

  write_ibases /root root root
  write_desktop_shortcut /root root root
}

run_as() {
  target_user="$1"
  shift
  if getent passwd "$target_user" >/dev/null 2>&1; then
    target_home="$(getent passwd "$target_user" | cut -d: -f6)"
    exec env HOME="$target_home" USER="$target_user" LOGNAME="$target_user" s6-setuidgid "$target_user" "$@"
  fi

  if [ "$target_user" = "root" ]; then
    exec s6-setuidgid root "$@"
  fi

  echo "Required runtime user is missing: $target_user" >&2
  exit 1
}

configure_unsafe_action_protection
configure_hardware_license_defaults
configure_nethasp_locations
configure_desktop_integration

case "$runtime_mode" in
  license-ui)
    if [ -x /opt/1cv8/current/1cv8c ]; then
      run_as usr1cv8 /opt/1cv8/current/1cv8c
    fi
    run_as usr1cv8 /opt/1cv8/current/1cv8
    ;;
  file-db)
    mkdir -p "$(dirname "$file_db_path")"
    run_as usr1cv8 /opt/1cv8/current/1cv8 ENTERPRISE /F "$file_db_path"
    ;;
  server)
    if [ ! -x /opt/1cv8/current/ragent ]; then
      echo "Server runtime requested, but /opt/1cv8/current/ragent is not installed" >&2
      exit 1
    fi
    run_as usr1cv8 /opt/1cv8/current/ragent -debug "-port" "$srv_port" "-regport" "$srv_regport" "-range" "$srv_range"
    ;;
  shell)
    exec s6-setuidgid root sh -lc 'trap : TERM INT; while :; do sleep 3600; done'
    ;;
  *)
    echo "Unknown ONEC_RUNTIME_MODE: $runtime_mode" >&2
    echo "Supported modes: license-ui, file-db, server, shell" >&2
    exit 1
    ;;
esac
