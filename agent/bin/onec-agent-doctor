#!/usr/bin/env bash
set -euo pipefail

project_root="${ONEC_PROJECT_ROOT:-/workspace/project}"
registry_path="${ONEC_AGENT_REGISTRY:-/opt/onec-agent/registry.json}"

status=0

check_path() {
  local label="$1"
  local path="$2"

  if [[ -e "$path" ]]; then
    printf '%-28s OK %s\n' "$label:" "$path"
  else
    printf '%-28s MISSING %s\n' "$label:" "$path"
    status=1
  fi
}

printf '1C agent runtime doctor\n'
printf '=======================\n'
if [[ -d "$project_root" ]]; then
  printf '%-28s OK %s\n' "project mount:" "$project_root"
elif [[ "${ONEC_REQUIRE_PROJECT:-0}" != "1" ]]; then
  printf '%-28s OPTIONAL standalone container mode\n' "project mount:"
else
  printf '%-28s MISSING %s\n' "project mount:" "$project_root"
  status=1
fi
check_path "agent registry" "$registry_path"
check_path "skills root" "/opt/onec-skills"
check_path "1C current symlink" "/opt/1cv8/current"

printf '%-28s ' "python3:"
if command -v python3 >/dev/null 2>&1; then
  python3 --version
else
  printf 'MISSING\n'
  status=1
fi

printf '%-28s ' "oscript:"
if command -v oscript >/dev/null 2>&1; then
  oscript -version
else
  printf 'MISSING\n'
  status=1
fi

printf '%-28s ' "vrunner:"
if command -v vrunner >/dev/null 2>&1; then
  if vrunner version >/dev/null 2>&1; then
    vrunner version
  elif vrunner help >/dev/null 2>&1; then
    printf 'OK\n'
  else
    printf 'BROKEN\n'
    status=1
  fi
else
  printf 'MISSING\n'
  status=1
fi

printf '%-28s ' "onec-hbk-bsl:"
if command -v onec-hbk-bsl >/dev/null 2>&1; then
  onec-hbk-bsl --version
else
  printf 'MISSING\n'
  status=1
fi

printf '%-28s ' "onec-agent-context-mcp:"
if command -v onec-agent-context-mcp >/dev/null 2>&1; then
  printf 'external endpoint adapter\n'
else
  printf 'MISSING\n'
  status=1
fi

printf '%-28s ' "oacs:"
if command -v acs >/dev/null 2>&1; then
  acs --help >/dev/null && printf 'OK\n'
else
  printf 'disabled (optional)\n'
fi

if [[ -f "$registry_path" ]]; then
  context_mcp_mode="$(jq -r '.tools["onec-context-mcp"].mode // empty' "$registry_path")"
  context_mcp_url="$(jq -r '.tools["onec-context-mcp"].url // empty' "$registry_path")"

  printf '\ncontext MCP\n'
  if [[ "$context_mcp_mode" == "external" ]]; then
    printf '%-28s OK external\n' "context mode:"
  else
    printf '%-28s MISSING registry tools.onec-context-mcp.mode=external\n' "context mode:"
    status=1
  fi

  if [[ -n "$context_mcp_url" ]]; then
    printf '%-28s OK %s\n' "context MCP URL:" "${ONEC_CONTEXT_MCP_URL:-$context_mcp_url}"
  else
    printf '%-28s MISSING registry tools.onec-context-mcp.url\n' "context MCP URL:"
    status=1
  fi

  printf '\nskills\n'
  while IFS= read -r line; do
    entrypoint="${line#*: }"
    if [[ -f "$entrypoint" ]]; then
      printf '  OK      %s\n' "$line"
    else
      printf '  MISSING %s\n' "$line"
      status=1
    fi
  done < <(jq -r '.skills | to_entries[] | "\(.key): \(.value.entrypoint)"' "$registry_path")
fi

exit "$status"
