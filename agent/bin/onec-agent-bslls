#!/usr/bin/env bash
set -euo pipefail

project_root="${ONEC_PROJECT_ROOT:-/workspace/project}"
mode="${BSLLS_MODE:-analyze}"
src_dir="${BSLLS_SRC_DIR:-${1:-$project_root}}"
output_dir="${BSLLS_OUTPUT_DIR:-$project_root/.agent/bslls}"
reporters="${BSLLS_REPORTERS:-json}"

if [[ "$mode" == "analyze" && ! -d "$src_dir" ]]; then
  printf 'BSLLS source directory does not exist: %s\n' "$src_dir" >&2
  exit 2
fi

if [[ "$mode" == "format" && ! -e "$src_dir" ]]; then
  printf 'BSLLS source path does not exist: %s\n' "$src_dir" >&2
  exit 2
fi

mkdir -p "$output_dir"

case "$mode" in
  analyze)
    args=(analyze --silent --srcDir "$src_dir" --outputDir "$output_dir")
    IFS=',' read -ra reporter_list <<< "$reporters"
    for reporter in "${reporter_list[@]}"; do
      if [[ -n "$reporter" ]]; then
        args+=(--reporter "$reporter")
      fi
    done
    ;;
  format)
    args=(format --silent --src "$src_dir")
    ;;
  *)
    printf 'Unknown BSLLS mode: %s\n' "$mode" >&2
    exit 2
    ;;
esac

stdout_file="$(mktemp)"
stderr_file="$(mktemp)"
set +e
bsl-language-server "${args[@]}" >"$stdout_file" 2>"$stderr_file"
rc="$?"
set -e

if [[ "$mode" == "analyze" ]]; then
  set +e
  python3 - "$output_dir" "$rc" "$stdout_file" "$stderr_file" "${BSLLS_VERBOSE_LOGS:-0}" <<'PY'
import collections
import json
import pathlib
import sys
import urllib.parse

output_dir = pathlib.Path(sys.argv[1])
rc = int(sys.argv[2])
stdout_file = pathlib.Path(sys.argv[3])
stderr_file = pathlib.Path(sys.argv[4])
verbose_logs = sys.argv[5] == "1"
report = output_dir / "bsl-json.json"
print(f"BSLLS report: {report}")
print(f"BSLLS exit code: {rc}")
if not report.exists():
    stdout = stdout_file.read_text(encoding="utf-8", errors="replace")
    stderr = stderr_file.read_text(encoding="utf-8", errors="replace")
    if stdout:
        print(stdout.rstrip())
    if stderr:
        print(stderr.rstrip(), file=sys.stderr)
    raise SystemExit(rc)

data = json.loads(report.read_text(encoding="utf-8"))
files = data.get("fileinfos") or data.get("files") or []
severity = collections.Counter()
codes = collections.Counter()
diagnostics_total = 0
files_with_diagnostics = 0
for file_info in files:
    diagnostics = file_info.get("diagnostics", [])
    if diagnostics:
        files_with_diagnostics += 1
    diagnostics_total += len(diagnostics)
    for diagnostic in diagnostics:
        severity[str(diagnostic.get("severity", "Unknown"))] += 1
        code = diagnostic.get("code")
        if isinstance(code, dict):
            code = code.get("left") or code.get("right")
        codes[str(code)] += 1

print(f"Analyzed files: {len(files)}")
print(f"Files with diagnostics: {files_with_diagnostics}")
print(f"Diagnostics total: {diagnostics_total}")
if severity:
    print("By severity: " + ", ".join(f"{key}={value}" for key, value in severity.most_common()))
if codes:
    print("Top diagnostics: " + ", ".join(f"{key}={value}" for key, value in codes.most_common(10)))

shown = 0
for file_info in files:
    raw_path = file_info.get("path", "")
    path = urllib.parse.unquote(raw_path).replace("file://", "")
    diagnostics = file_info.get("diagnostics", [])
    for diagnostic in diagnostics:
        start = (diagnostic.get("range") or {}).get("start") or {}
        line = start.get("line")
        line_text = "" if line is None else f":{int(line) + 1}"
        code = diagnostic.get("code")
        if isinstance(code, dict):
            code = code.get("left") or code.get("right")
        print(f"- {path}{line_text} [{diagnostic.get('severity')}] {code}: {diagnostic.get('message')}")
        shown += 1
        if shown >= 12:
            break
    if shown >= 12:
        break

if verbose_logs:
    stdout = stdout_file.read_text(encoding="utf-8", errors="replace").strip()
    stderr = stderr_file.read_text(encoding="utf-8", errors="replace").strip()
    if stdout:
        print("\nRaw BSLLS stdout:\n" + stdout)
    if stderr:
        print("\nRaw BSLLS stderr:\n" + stderr, file=sys.stderr)

raise SystemExit(rc)
PY
  result="$?"
  set -e
  rm -f "$stdout_file" "$stderr_file"
  exit "$result"
fi

if [[ "$rc" != "0" || "${BSLLS_VERBOSE_LOGS:-0}" == "1" ]]; then
  cat "$stdout_file"
  cat "$stderr_file" >&2
fi
rm -f "$stdout_file" "$stderr_file"
exit "$rc"
