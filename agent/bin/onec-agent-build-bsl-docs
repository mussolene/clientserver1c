#!/usr/bin/env python3
"""Build a compact BSL developer guide KB pack for onec-context query-kb."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sqlite3
import time
from collections import Counter
from pathlib import Path

import zstandard


FRONTMATTER_RE = re.compile(r"^---\n.*?\n---\n+", re.DOTALL)
HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*$")


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def compact_text(text: str, max_chars: int) -> str:
    value = " ".join((text or "").split())
    if len(value) <= max_chars:
        return value
    return value[: max_chars - 3].rstrip() + "..."


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def markdown_files(source_dir: Path):
    for path in sorted(source_dir.rglob("*.md")):
        if path.is_file() and ".git" not in path.parts and not path.name.startswith("_"):
            yield path


def create_docs_db(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()
    con = sqlite3.connect(path)
    cur = con.cursor()
    cur.execute("PRAGMA journal_mode=OFF")
    cur.execute("PRAGMA synchronous=OFF")
    cur.execute("PRAGMA temp_store=MEMORY")
    cur.execute("PRAGMA cache_size=-80000")
    cur.execute(
        """
        CREATE TABLE docs(
            id INTEGER PRIMARY KEY,
            domain TEXT NOT NULL,
            name TEXT,
            topic_path TEXT,
            version TEXT,
            versions_json TEXT,
            payload TEXT
        )
        """
    )
    cur.execute(
        """
        CREATE VIRTUAL TABLE docs_fts
        USING fts5(name, payload, content='docs', content_rowid='id')
        """
    )
    con.commit()
    return con


def finalize_docs_db(con: sqlite3.Connection) -> None:
    cur = con.cursor()
    cur.execute("INSERT INTO docs_fts(rowid, name, payload) SELECT id, name, payload FROM docs")
    cur.execute("CREATE INDEX idx_docs_domain ON docs(domain)")
    cur.execute("CREATE INDEX idx_docs_version ON docs(version)")
    con.commit()
    cur.execute("VACUUM")
    con.commit()


def compress_zstd(src: Path, dst: Path, level: int = 19) -> int:
    dst.parent.mkdir(parents=True, exist_ok=True)
    compressor = zstandard.ZstdCompressor(level=level)
    with src.open("rb") as inp, dst.open("wb") as out:
        compressor.copy_stream(inp, out)
    return dst.stat().st_size


def topic_path(rel_path: str, heading_path: str) -> str:
    anchor = re.sub(r"[^\w\u0400-\u04FF]+", "-", heading_path.lower(), flags=re.UNICODE).strip("-")
    return f"{rel_path}#{anchor}" if anchor else rel_path


def iter_chunks(path: Path, source_dir: Path, max_payload_chars: int):
    rel = str(path.relative_to(source_dir)).replace("\\", "/")
    text = FRONTMATTER_RE.sub("", path.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n"))
    headings: list[tuple[int, str]] = []
    body: list[str] = []
    kind = "section"
    document_title = path.stem

    def flush():
        nonlocal body, kind
        content = "\n".join(body).strip()
        if not content:
            body = []
            kind = "section"
            return None
        current_heading_path = " > ".join(title for _, title in headings) or document_title
        title = headings[-1][1] if headings else document_title
        label = f"{title} [пример]" if kind == "example" else title
        payload = compact_text(content, max_payload_chars)
        row = {
            "name": label,
            "topic_path": topic_path(rel, current_heading_path),
            "payload": payload,
            "kind": kind,
        }
        body = []
        kind = "section"
        return row

    for line in text.split("\n"):
        match = HEADING_RE.match(line)
        if match:
            row = flush()
            if row:
                yield row
            level = len(match.group(1))
            title = match.group(2).strip()
            headings = [(old_level, old_title) for old_level, old_title in headings if old_level < level]
            headings.append((level, title))
            continue
        if line.strip() == "Копировать в буфер обмена":
            row = flush()
            if row:
                yield row
            kind = "example"
            continue
        body.append(line)

    row = flush()
    if row:
        yield row


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source-dir", required=True)
    parser.add_argument("--db-path", required=True)
    parser.add_argument("--out-zst", required=True)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--source-url", required=True)
    parser.add_argument("--source-ref", required=True)
    parser.add_argument("--source-commit", required=True)
    parser.add_argument("--max-payload-chars", type=int, default=4000)
    parser.add_argument("--keep-db", action="store_true")
    args = parser.parse_args()

    t0 = time.time()
    source_dir = Path(args.source_dir).resolve()
    db_path = Path(args.db_path).resolve()
    out_zst = Path(args.out_zst).resolve()
    manifest_path = Path(args.manifest).resolve()

    con = create_docs_db(db_path)
    cur = con.cursor()
    rows_total = 0
    input_bytes = 0
    domain_counts: Counter[str] = Counter()
    version_counts: Counter[str] = Counter()

    for md_file in markdown_files(source_dir):
        input_bytes += md_file.stat().st_size
        for row in iter_chunks(md_file, source_dir, max(400, args.max_payload_chars)):
            cur.execute(
                """
                INSERT INTO docs(domain, name, topic_path, version, versions_json, payload)
                VALUES(?, ?, ?, ?, ?, ?)
                """,
                (
                    "bsl_dev",
                    row["name"],
                    row["topic_path"],
                    args.version,
                    json.dumps([args.version], ensure_ascii=False),
                    row["payload"],
                ),
            )
            rows_total += 1
            domain_counts["bsl_dev"] += 1
            version_counts[args.version] += 1

    if rows_total <= 0:
        raise SystemExit(f"No BSL developer docs rows were built from {source_dir}")

    con.commit()
    finalize_docs_db(con)
    con.close()
    zst_bytes = compress_zstd(db_path, out_zst)
    db_bytes = db_path.stat().st_size

    manifest = {
        "kind": "bsl_dev_docs",
        "created_at": now_iso(),
        "duration_sec": round(time.time() - t0, 3),
        "source": {
            "url": args.source_url,
            "ref": args.source_ref,
            "commit": args.source_commit,
            "path": str(source_dir),
        },
        "version": args.version,
        "stats": {
            "rows_total": rows_total,
            "domain_counts": dict(domain_counts),
            "versions_seen": dict(version_counts),
            "raw_input_bytes": input_bytes,
            "db_bytes": db_bytes,
            "zst_bytes": zst_bytes,
            "db_sha256": sha256_file(db_path),
            "zst_sha256": sha256_file(out_zst),
        },
    }
    manifest_path.parent.mkdir(parents=True, exist_ok=True)
    manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    if not args.keep_db:
        db_path.unlink(missing_ok=True)

    print(f"bsl dev docs kb built: rows={rows_total}")
    print(f"  input={input_bytes / 1024 / 1024:.1f} MB")
    print(f"  db={db_bytes / 1024 / 1024:.1f} MB ({db_path})")
    print(f"  zst={zst_bytes / 1024 / 1024:.1f} MB ({out_zst})")
    print(f"  domains={dict(domain_counts)}")
    print(f"  versions={dict(version_counts)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
