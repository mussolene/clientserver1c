#!/usr/bin/env bash
set -euo pipefail

project_root="${ONEC_PROJECT_ROOT:-/workspace/project}"
registry_path="${ONEC_AGENT_REGISTRY:-/opt/onec-agent/registry.json}"
oacs_db="${OACS_DB:-$project_root/.agent/oacs/oacs.db}"
oacs_passphrase="${OACS_PASSPHRASE:-${ONEC_OACS_PASSPHRASE:-}}"
task="${ONEC_BOOTSTRAP_TASK:-pai_bootstrap}"
query="${ONEC_BOOTSTRAP_QUERY:-ЗаписьJSON}"
limit="${ONEC_BOOTSTRAP_LIMIT:-3}"

usage() {
  cat <<'EOF'
Usage:
  onec-agent bootstrap

Prepare the mounted project for Portable Agent Infrastructure work:
- initialize project-local OACS state under .agent/oacs
- write MCP config under .agent/mcp
- build a minimal context capsule under .agent/context-capsules
- write agent instructions for the OACS memory call loop

Run inside the container with the project mounted at /workspace/project,
or set ONEC_PROJECT_ROOT to another mounted path.
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

require_project() {
  [[ -d "$project_root" ]] || die "Project mount is missing: $project_root"
}

write_agent_instructions() {
  local target="$1"
  cat >"$target" <<'EOF'
# PAI Agent Instructions

Work from the host IDE, but use the mounted Portable Agent Infrastructure container for 1C-specific facts and checks.

Before changing 1C metadata, BSL, tests, or runtime scripts:

1. Read `.agent/bootstrap-report.md`.
2. Export project-local ACS state:
   `export OACS_DB="${ONEC_PROJECT_ROOT:-/workspace/project}/.agent/oacs/oacs.db"`
   `export OACS_PASSPHRASE="<local-oacs-passphrase>"`
3. Query project memory with ACS:
   `acs memory query --query "<task intent>" --scope project --json`
4. Build an ACS context capsule for the current task:
   `acs context build --intent "<task intent>" --scope project --json`
5. Build a 1C task context capsule:
   `onec-agent context --query "<exact 1C term>" --pack platform --limit 5`
6. Query developer-guide facts when the task needs behavior, patterns, or examples:
   `onec-agent context --query "<1C developer guide topic>" --pack bsl-dev --limit 5`
7. Query project metadata after bootstrap when the task is about project objects:
   `onec-agent context --query "<metadata object>" --pack metadata --limit 5`
8. Use the relevant skill instructions from:
   - `/opt/onec-skills/onec-context-toolkit/skill/SKILL.md`
   - `/opt/onec-skills/onec-vanessa-skill/skill/core/SKILL.md`
   - `/opt/onec-agent/skills/memory/SKILL.md`
   - `/opt/onec-agent/skills/codex_oacs_runtime/SKILL.md`
9. Run focused checks inside the container.
10. Capture durable conclusions only after verification with direct ACS memory commands.

Rules:

- Treat OACS as memory, evidence, and context governance. It is not the runtime orchestrator.
- Use `acs` directly for memory, context capsules, MCP import, and evidence.
  Use `onec-agent` for 1C retrieval, diagnostics, skills, and runtime checks.
- Prefer exact platform, developer-guide, standards, and project context-pack facts over remembered guesses.
- Do not store secrets, ITS credentials, license data, or full help dumps in OACS.
- Keep project state under `.agent/`.
EOF
}

write_memory_loop() {
  local target="$1"
  cat >"$target" <<'EOF'
# OACS Memory Call Loop

Use this loop for every non-trivial task.

1. `acs memory query`: find prior project decisions and constraints.
2. `acs context build`: create the task capsule for current repo/project state.
3. `onec-agent context`: run exact 1C lookups against platform, developer-guide, standards, metadata, or code packs.
4. Work against the current project files.
5. Verify with the narrowest relevant command.
6. `acs run`: execute checks and save command outputs as evidence.
7. `acs memory propose` / `commit` / `sharpen`: save only reusable verified conclusions, linked to evidence.

Minimal commands:

```bash
export OACS_DB="${ONEC_PROJECT_ROOT:-/workspace/project}/.agent/oacs/oacs.db"
export OACS_PASSPHRASE="<local-oacs-passphrase>"
acs memory query --query "<task intent>" --scope project --json
acs context build --intent "<task intent>" --scope project --json
onec-agent context --query "<1C term>" --pack platform --limit 5
onec-agent context --query "<1C behavior or example>" --pack bsl-dev --limit 5
onec-agent context --query "<metadata object>" --pack metadata --limit 5
acs run --label "<check label>" --scope project --json -- <check command>
acs resume --scope project --json
candidate="$(acs memory propose --type procedure --depth 2 --scope project --text "<verified conclusion>" --json)"
memory_id="$(printf '%s' "$candidate" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
acs memory commit "$memory_id" --json
acs memory sharpen "$memory_id" --evidence "<ev_...>" --json
```
EOF
}

write_cross_repo_findings_capsule() {
  local capsule_target="$1"
  local memories_target="$2"
  python3 - "$capsule_target" "$memories_target" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

capsule_target = Path(sys.argv[1])
memories_target = Path(sys.argv[2])

memories = [
    {
        "id": "mem_pai_runtime_contract_001",
        "memory_type": "rule",
        "depth": 2,
        "lifecycle_status": "active",
        "status": "active",
        "namespace": "pai-bootstrap",
        "scope": ["project", "pai", "runtime"],
        "owner_actor_id": None,
        "content": {
            "text": "PAI runtime targets linux/amd64 only for the current 1C ecosystem; VNC should start by default and 1C should be launched through the platform-installed 1cestart launcher.",
            "kind": "rule",
            "tags": ["runtime", "vnc", "launcher"],
            "confidence": 1.0,
            "evidence": [],
        },
        "evidence_refs": [],
        "supersedes": None,
    },
    {
        "id": "mem_pai_oacs_workflow_001",
        "memory_type": "procedure",
        "depth": 2,
        "lifecycle_status": "active",
        "status": "active",
        "namespace": "pai-bootstrap",
        "scope": ["project", "pai", "oacs"],
        "owner_actor_id": None,
        "content": {
            "text": "Use acs directly for memory, context capsules, and evidence. Use onec-agent only as the 1C adapter for context lookup, diagnostics, bootstrap artifacts, and runtime checks.",
            "kind": "procedure",
            "tags": ["oacs", "workflow", "onec-agent"],
            "confidence": 1.0,
            "evidence": [],
        },
        "evidence_refs": [],
        "supersedes": None,
    },
    {
        "id": "mem_pai_epf_roundtrip_001",
        "memory_type": "procedure",
        "depth": 2,
        "lifecycle_status": "active",
        "status": "active",
        "namespace": "pai-bootstrap",
        "scope": ["project", "pai", "testing"],
        "owner_actor_id": None,
        "content": {
            "text": "EPF round-trip inside the container uses vrunner decompileepf and vrunner compileepf. Decompiled EPF trees expose XML, forms, and BSL modules for review.",
            "kind": "procedure",
            "tags": ["epf", "xunit", "vrunner"],
            "confidence": 1.0,
            "evidence": [],
        },
        "evidence_refs": [],
        "supersedes": None,
    },
    {
        "id": "mem_pai_vanessa_diagnostics_001",
        "memory_type": "procedure",
        "depth": 2,
        "lifecycle_status": "active",
        "status": "active",
        "namespace": "pai-bootstrap",
        "scope": ["project", "pai", "testing"],
        "owner_actor_id": None,
        "content": {
            "text": "Diagnose Vanessa failures by stage: JSON parse and schema shape, library path availability, duplicate snippets, then feature loading and tag selection. UI/xUnit wrappers should enforce timeout, deterministic failure artifacts, and process cleanup.",
            "kind": "procedure",
            "tags": ["vanessa", "xunit", "diagnostics"],
            "confidence": 1.0,
            "evidence": [],
        },
        "evidence_refs": [],
        "supersedes": None,
    },
]

capsule = {
    "id": "ctx_pai_cross_repo_findings_public_001",
    "version": "0.1",
    "capsule_type": "context_capsule",
    "purpose": "Orient an agent with anonymized confirmed PAI container and extension-test findings.",
    "task_id": "pai_cross_repo_findings_public",
    "actor_id": None,
    "agent_id": None,
    "scope": ["project", "pai", "public_anonymized"],
    "token_budget": 1600,
    "included_memories": [memory["id"] for memory in memories],
    "included_rules": ["rule_fuzzy_memory_not_fact"],
    "included_skills": [],
    "included_tools": [],
    "evidence_refs": [],
    "forbidden_assumptions": [
        "This public capsule is an orientation seed, not fresh runtime evidence.",
        "Do not treat project-specific hypotheses as confirmed facts unless backed by current OACS evidence.",
    ],
    "permissions": {
        "memory.query": True,
        "memory.commit": False,
        "tool.execute.read": True,
        "tool.execute.write": False,
    },
    "expires_at": None,
    "audit_refs": [],
    "checksum": "",
}

canonical = dict(capsule)
canonical.pop("checksum")
payload = json.dumps(canonical, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
capsule["checksum"] = hashlib.sha256(payload).hexdigest()

capsule_target.parent.mkdir(parents=True, exist_ok=True)
memories_target.parent.mkdir(parents=True, exist_ok=True)
capsule_target.write_text(json.dumps(capsule, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
memories_target.write_text(json.dumps(memories, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

project_file_sample_json() {
  python3 - "$project_root" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
patterns = [
    "**/Configuration.xml",
    "**/*.bsl",
    "**/*.os",
    "**/*.xml",
    "**/*.feature",
]
seen = []
for pattern in patterns:
    for path in root.glob(pattern):
        if ".agent" in path.parts:
            continue
        if path.is_file():
            seen.append(str(path.relative_to(root)))
        if len(seen) >= 50:
            break
    if len(seen) >= 50:
        break
print(json.dumps(seen, ensure_ascii=False, indent=2))
PY
}

main() {
  case "${1:-}" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_project
  require_command jq
  require_command python3
  require_command acs
  require_command onec-agent-context
  require_command onec-agent-doctor
  require_command onec-context
  [[ -f "$registry_path" ]] || die "Agent registry is missing: $registry_path"
  [[ -n "$oacs_passphrase" ]] || die "Set OACS_PASSPHRASE or ONEC_OACS_PASSPHRASE before bootstrap."

  local agent_dir mcp_dir capsule_dir instructions_dir report_dir capsule_path findings_capsule_path findings_memories_path report_path
  agent_dir="$project_root/.agent"
  mcp_dir="$agent_dir/mcp"
  capsule_dir="$agent_dir/context-capsules"
  instructions_dir="$agent_dir/instructions"
  report_dir="$agent_dir/reports"
  capsule_path="$capsule_dir/bootstrap-context-capsule.json"
  findings_capsule_path="$capsule_dir/cross-repo-findings-capsule.public.json"
  findings_memories_path="$report_dir/cross-repo-findings-memories.public.json"
  report_path="$agent_dir/bootstrap-report.md"

  mkdir -p "$(dirname "$oacs_db")" "$mcp_dir" "$capsule_dir" "$instructions_dir" "$report_dir"

  export OACS_DB="$oacs_db"
  export OACS_PASSPHRASE="$oacs_passphrase"
  export ONEC_PROJECT_ROOT="$project_root"
  export ONEC_AGENT_REGISTRY="$registry_path"

  acs init --json >"$report_dir/oacs-init.json"
  acs key init --passphrase "$oacs_passphrase" --json >"$report_dir/oacs-key-init.json"
  onec-agent-doctor >"$report_dir/onec-agent-doctor.txt"
  onec-agent-context mcp-config >"$mcp_dir/onec-context-mcp.json"
  acs context build --intent "$task" --scope project --budget "${ONEC_OACS_CONTEXT_BUDGET:-4000}" --json \
    >"$report_dir/oacs-bootstrap-context.json"
  onec-agent-context lookup --query "$query" --pack platform --limit "$limit" \
    >"$report_dir/onec-context-platform-lookup.json"
  onec-agent-context lookup --query "стандарты разработки" --pack standards --limit "$limit" \
    >"$report_dir/onec-context-standards-lookup.json"
  onec-agent-context lookup --query "фоновые задания" --pack bsl-dev --limit "$limit" \
    >"$report_dir/onec-context-bsl-dev-lookup.json"

  local metadata_status metadata_pack
  metadata_status="not-built"
  metadata_pack=""
  if onec-context init --workspace-root "$project_root" --source-path "$project_root" \
      --profile metadata --without-help --with-metadata \
      >"$report_dir/onec-context-metadata-ensure.log" 2>&1; then
    metadata_status="built"
    metadata_pack="$(onec-context resolve-packs --workspace-root "$project_root" --role metadata --path-only 2>/dev/null || true)"
  else
    metadata_status="not-available"
  fi

  write_agent_instructions "$instructions_dir/pai-agent-instructions.md"
  if [[ ! -e "$agent_dir/AGENTS.md" ]]; then
    write_agent_instructions "$agent_dir/AGENTS.md"
  fi
  write_memory_loop "$instructions_dir/oacs-memory-call-loop.md"
  write_cross_repo_findings_capsule "$findings_capsule_path" "$findings_memories_path"

  local project_files_json
  project_files_json="$(project_file_sample_json)"

  jq -n \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg project_root "$project_root" \
    --arg registry "$registry_path" \
    --arg oacs_db "$oacs_db" \
    --arg mcp_config "$mcp_dir/onec-context-mcp.json" \
    --arg platform_pack "$(jq -r '.packs.platform // empty' "$registry_path")" \
    --arg standards_pack "$(jq -r '.packs.standards // empty' "$registry_path")" \
    --arg bsl_dev_pack "$(jq -r '.packs.bsl_dev // empty' "$registry_path")" \
    --arg metadata_status "$metadata_status" \
    --arg metadata_pack "$metadata_pack" \
    --arg orientation_prompt 'You are working inside a project prepared by Portable Agent Infrastructure (PAI) for 1C development. PAI is the container/runtime infrastructure, not a product object named pai. The host IDE agent edits the mounted project; the container provides 1C runtime, VNC, OneScript, Vanessa, BSL Language Server, OACS/ACS, skills, and onec-context knowledge packs. Start every non-trivial task with direct acs memory query and acs context build against the project OACS DB, then use onec-agent only as the 1C adapter for context lookup, diagnostics, skills, bootstrap artifacts, ibase helpers, and runtime checks. Treat platform help, BSL developer guide, standards, and metadata packs as retrieval sources; do not paste full corpora into memory. The supported runtime/build target is linux/amd64. Licensing is optional for bootstrap/OACS/context, but 1C runtime checks need activation or a readable nethasp.ini mounted by local path only. Never store nethasp.ini contents, license data, ITS credentials, OACS DB files, platform archives, local host paths, or unrelated artifacts in git, reports, OACS memory, or context capsules.' \
    --argjson project_files "$project_files_json" \
    --slurpfile registry_json "$registry_path" \
    '{
      kind: "pai.bootstrap.context_capsule",
      created_at: $created_at,
      orientation_prompt: {
        role: "agent_system_orientation",
        text: $orientation_prompt
      },
      project_root: $project_root,
      oacs: {
        db: $oacs_db,
        direct_cli: "acs",
        context_command: "acs context build --intent \"<task intent>\" --scope project --json",
        memory_query_command: "acs memory query --query \"<task intent>\" --scope project --json",
        evidence_command: "acs run --label \"<check label>\" --scope project --json -- <check command>",
        resume_command: "acs resume --scope project --json",
        memory_call_loop: ".agent/instructions/oacs-memory-call-loop.md"
      },
      mcp: {
        config: $mcp_config,
        server: "onec-agent-context-mcp"
      },
      required_context: {
        platform_help_pack: $platform_pack,
        standards_pack: $standards_pack,
        bsl_dev_docs_pack: $bsl_dev_pack,
        metadata_pack_status: $metadata_status,
        metadata_pack: $metadata_pack,
        skills: ($registry_json[0].skills // {})
      },
      project_metadata_sample: $project_files,
      instructions: [
        ".agent/instructions/pai-agent-instructions.md",
        ".agent/AGENTS.md",
        ".agent/instructions/oacs-memory-call-loop.md"
      ],
      reports: [
        ".agent/reports/onec-agent-doctor.txt",
        ".agent/reports/oacs-bootstrap-context.json",
        ".agent/reports/onec-context-platform-lookup.json",
        ".agent/reports/onec-context-standards-lookup.json",
        ".agent/reports/onec-context-bsl-dev-lookup.json",
        ".agent/reports/cross-repo-findings-memories.public.json",
        ".agent/reports/onec-context-metadata-ensure.log"
      ],
      additional_capsules: [
        ".agent/context-capsules/cross-repo-findings-capsule.public.json"
      ]
    }' >"$capsule_path"

  cat >"$report_path" <<EOF
# PAI Bootstrap Report

Status: PASS

Project root: \`$project_root\`
OACS DB: \`$oacs_db\`
MCP config: \`.agent/mcp/onec-context-mcp.json\`
Context capsule: \`.agent/context-capsules/bootstrap-context-capsule.json\`
Cross-repo findings capsule: \`.agent/context-capsules/cross-repo-findings-capsule.public.json\`
Cross-repo findings memories: \`.agent/reports/cross-repo-findings-memories.public.json\`
Agent instructions: \`.agent/instructions/pai-agent-instructions.md\`
Memory loop: \`.agent/instructions/oacs-memory-call-loop.md\`

## Agent Start

Read \`.agent/instructions/pai-agent-instructions.md\`. If bootstrap created \`.agent/AGENTS.md\`, read it as the IDE entrypoint too. Then use:

\`\`\`bash
acs memory query --query "<task intent>" --scope project --json
acs context build --intent "<task intent>" --scope project --json
onec-agent context --query "<exact 1C term>" --pack platform --limit 5
onec-agent context --query "<developer guide topic>" --pack bsl-dev --limit 5
onec-agent context --query "<metadata object>" --pack metadata --limit 5
acs run --label "<check label>" --scope project --json -- <check command>
acs resume --scope project --json
candidate_json=\$(acs memory propose --type procedure --depth 2 --scope project --text "<verified reusable fact>" --json)
memory_id=\$(printf '%s' "\$candidate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')
acs memory commit "\$memory_id" --json
acs memory sharpen "\$memory_id" --evidence "<evidence ref>" --json
\`\`\`

## Required Context

- Platform help pack: \`$(jq -r '.packs.platform // empty' "$registry_path")\`
- Standards pack: \`$(jq -r '.packs.standards // empty' "$registry_path")\`
- BSL developer docs pack: \`$(jq -r '.packs.bsl_dev // empty' "$registry_path")\`
- Metadata pack status: \`$metadata_status\`
- Skills registry: \`$registry_path\`

Do not restart or recreate the container for normal agent work. Keep it running in shell mode and use \`docker exec\`, Compose transport commands, or IDE tool calls to invoke \`onec-agent\`.
EOF

  printf 'PAI bootstrap: PASS\n'
  printf 'Report: %s\n' "$report_path"
  printf 'Capsule: %s\n' "$capsule_path"
  printf 'Cross-repo findings capsule: %s\n' "$findings_capsule_path"
  printf 'Cross-repo findings memories: %s\n' "$findings_memories_path"
  printf 'Instructions: %s\n' "$instructions_dir/pai-agent-instructions.md"
  printf 'MCP config: %s\n' "$mcp_dir/onec-context-mcp.json"
}

main "$@"
