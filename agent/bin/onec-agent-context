#!/usr/bin/env bash
set -euo pipefail

project_root="${ONEC_PROJECT_ROOT:-/workspace/project}"
registry_path="${ONEC_AGENT_REGISTRY:-/opt/onec-agent/registry.json}"
context_mcp_url="${ONEC_CONTEXT_MCP_URL:-http://localhost:8050/mcp}"

usage() {
  cat <<'EOF'
Usage:
  onec-agent-context doctor
  onec-agent-context lookup --query <text>
  onec-agent-context mcp-config

This command publishes the external 1C Context MCP contract. Use acs directly
for OACS memory, task context capsules, and evidence.
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

cmd_lookup() {
  die "Local context packs are not embedded in this image. Start 1c_hbk_helper/onec-context-mcp and use MCP URL: $context_mcp_url"
}

cmd_mcp_config() {
  jq -n --arg url "$context_mcp_url" '{
    mcpServers: {
      "onec-context-mcp": {
        url: $url
      }
    }
  }'
}

cmd_doctor() {
  printf '1C context MCP: external\n'
  printf 'MCP URL: %s\n' "$context_mcp_url"
  if [[ -f "$registry_path" ]]; then
    jq -r '.tools["onec-context-mcp"].url // empty' "$registry_path" | sed 's/^/Registry URL: /'
  fi
  if ! command -v acs >/dev/null 2>&1; then
    printf 'OACS: MISSING (rebuild the 1c-dev image)\n'
    exit 1
  fi
  printf 'OACS: '
  acs --help >/dev/null && printf 'OK %s\n' "$(command -v acs)"
}

cmd_legacy_mcp_config_example() {
  cat <<'JSON'
{
  "mcpServers": {
    "onec-context-mcp": {
      "url": "http://localhost:8050/mcp"
    }
  }
}
JSON
}

mode="${1:-}"
shift || true
case "$mode" in
  doctor) cmd_doctor "$@" ;;
  lookup) cmd_lookup "$@" ;;
  mcp-config) cmd_mcp_config "$@" ;;
  ""|-h|--help) usage ;;
  *) die "Unknown mode: $mode" ;;
esac
