#!/usr/bin/with-contenv sh
set -eu

ras_port="${RAS_PORT:-1545}"
ragent_host="${SRV1CV8_HOST:-localhost}"
ragent_port="${SRV1CV8_PORT:-1540}"

if [ ! -x /opt/1cv8/current/ras ]; then
  echo "RAS runtime requested, but /opt/1cv8/current/ras is not installed" >&2
  exit 1
fi

sleep "${RAS_START_DELAY:-3}"
exec s6-setuidgid usr1cv8 /opt/1cv8/current/ras cluster "--port=${ras_port}" "${ragent_host}:${ragent_port}"
